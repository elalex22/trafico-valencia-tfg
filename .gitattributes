# Saltos de línea: LF en el repositorio y en la copia de trabajo para el
# código, los scripts, la configuración y los requirements (evita los
# avisos de CRLF y problemas dentro del contenedor Docker).
* text=auto
*.py   text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
